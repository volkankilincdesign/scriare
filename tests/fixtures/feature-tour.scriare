  "entities": [
    {
      "id": "e-mara",
      "kind": "character",
      "name": "Mara Vance",
      "aliases": [
        "Mara"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null,
              "textAlign": null,
              "lineId": "t_a-character-so-the-edi"
            },
            "content": [
              {
                "type": "text",
                "text": "A character, so the editor has something to attribute a line to."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null,
              "textAlign": null,
              "lineId": "t_she-has-an-alias-so-ty"
            },
            "content": [
              {
                "type": "text",
                "text": "She has an alias, so typing @Mara finds her as well as her full name. Rename her in this panel and every sentence in the story follows, because nothing anywhere stored her name — only who she is."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-archivist",
      "kind": "character",
      "name": "The Archivist",
      "aliases": [],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null,
              "textAlign": null,
              "lineId": "t_a-second-character-so-"
            },
            "content": [
              {
                "type": "text",
                "text": "A second character, so speaker attribution has somebody to swap to."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-reading-room",
      "kind": "location",
      "name": "The Reading Room",
      "aliases": [
        "the room"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null,
              "textAlign": null,
              "lineId": "t_a-location-locations-c"
            },
            "content": [
              {
                "type": "text",
                "text": "A location. Locations can be mentioned but cannot speak — the speaker picker will not offer this one."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-stair",
      "kind": "location",
      "name": "The Lantern Stair",
      "aliases": [],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null,
              "textAlign": null,
              "lineId": "t_a-second-location-ment"
            },
            "content": [
              {
                "type": "text",
                "text": "A second location, mentioned in chapter two."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-note-how",
      "kind": "note",
      "name": "How this story is put together",
      "aliases": [],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 2,
              "textAlign": null,
              "lineId": "h_what-this-file-is"
            },
            "content": [
              {
                "type": "text",
                "text": "What this file is"
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null,
              "textAlign": null,
              "lineId": "t_a-placeholder-every-sc"
            },
            "content": [
              {
                "type": "text",
                "text": "A placeholder. Every scene demonstrates one part of the app and says so in its own text."
              }
            ]
          },
          {
            "type": "bulletList",
            "content": [
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "speaker": null,
                      "textAlign": null,
                      "lineId": "t_three-chapters-twelve-"
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "Three chapters, twelve scenes, three endings — one of them behind a condition."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "speaker": null,
                      "textAlign": null,
                      "lineId": "t_three-variables-a-numb"
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "Three variables: a number, a boolean, and a second boolean used as a key."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "speaker": null,
                      "textAlign": null,
                      "lineId": "t_choices-that-set-add-a"
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "Choices that set, add and toggle; choices that hide; choices that lock with a reason."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "speaker": null,
                      "textAlign": null,
                      "lineId": "t_a-conversation-that-st"
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "A conversation that stays on the page, with a line that repeats and a line that leaves."
                      }
                    ]
                  }
                ]
              },
              {
                "type": "listItem",
                "content": [
                  {
                    "type": "paragraph",
                    "attrs": {
                      "speaker": null,
                      "textAlign": null,
                      "lineId": "t_prose-gated-behind-a-c"
                    },
                    "content": [
                      {
                        "type": "text",
                        "text": "Prose gated behind a condition, a loop back to an earlier scene, and a merge."
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null,
              "textAlign": null,
              "lineId": "t_a-note-is-writer-only-"
            },
            "content": [
              {
                "type": "text",
                "text": "A note is writer-only: it can mention the story, and the story cannot mention it."
              }
            ]
          }
        ]
      }
    }
  ]
