  ],
  "favorites": [],
  "variables": [
    {
      "id": "v-resolve",
      "name": "resolve",
      "type": "number",
      "defaultValue": 0,
      "description": "How firmly you have landed anywhere. Speaking at the vote needs 3."
    },
    {
      "id": "v-offer",
      "name": "hikmet_offer",
      "type": "boolean",
      "defaultValue": false,
      "description": "Hikmet has named the supervisor's job out loud."
    },
    {
      "id": "v-roster",
      "name": "knows_roster",
      "type": "boolean",
      "defaultValue": false,
      "description": "You have seen the staffing list for the new plant."
    },
    {
      "id": "v-warned",
      "name": "deniz_warned",
      "type": "boolean",
      "defaultValue": false,
      "description": "Deniz knows what tonight is."
    },
    {
      "id": "v-voices",
      "name": "voices_heard",
      "type": "number",
      "defaultValue": 0,
      "description": "How many times you have let one of them finish."
    }
  ],
  "choiceStyles": [
    {
      "id": "default",
      "name": "Default",
      "box": {
        "fill": "var(--surface-2-translucent)",
        "border": "var(--border)",
        "borderWidth": 1,
        "radius": 6
      }
    },
    {
      "id": "cs-voice",
      "name": "Inner Voice",
      "box": {
        "fill": null,
        "border": "var(--accent)",
        "borderWidth": 1,
        "radius": 2
      }
    }
  ],
  "entities": [
    {
      "id": "e-nesrin",
      "kind": "character",
      "name": "Nesrin Aydın",
      "aliases": [
        "Nesrin"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Organiser. Fourteen years, all of them on the third and fourth vats."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Counts before she argues. Has known the number since Tuesday and has not told anyone it, because a number said too early is a number people start planning around."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Her surname is here on purpose: it is the test case for Turkish folding — searching \"aydin\" has to find \"Aydın\"."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-hikmet",
      "kind": "character",
      "name": "Hikmet Bal",
      "aliases": [
        "Hikmet",
        "the foreman"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Foreman. Nineteen years, six of them on the floor and thirteen above it."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Does not lie at any point in this story. Arranges true things in an order, which the writer should treat as a different offence and not a lesser one."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-deniz",
      "kind": "character",
      "name": "Deniz",
      "aliases": [
        "the boy"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Nineteen. Five weeks in. Still proud of the blue in his knuckles."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Exists so that something can be done TO someone by the player's inaction rather than their action."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-arithmetic",
      "kind": "character",
      "name": "ARITHMETIC",
      "aliases": [
        "Arithmetic"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Inner voice. Counts. Is almost always correct and almost never sufficient."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Register: flat, declarative, faintly pleased with itself. Never uses a metaphor. Says numbers out loud."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-hands",
      "kind": "character",
      "name": "THE HANDS",
      "aliases": [
        "The Hands",
        "Hands"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Inner voice. Eleven years of muscle memory with opinions."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Register: sensory, present tense, short sentences. Talks about weight, temperature, the wrist. Never argues about money."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-appetite",
      "kind": "character",
      "name": "APPETITE",
      "aliases": [
        "Appetite"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Inner voice. Self-interest, stated without shame, which is what makes it persuasive."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Register: reasonable, warm, second person. Always offers the player a way out that costs nothing visible."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-vat-floor",
      "kind": "location",
      "name": "The Vat Floor",
      "aliases": [
        "the floor",
        "sixth vat"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Six indigo vats, sunk to the rim. Wet stone, steam, the smell of sizing."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Indigo is bronze in the vat and only turns blue in the air. The whole story is in that sentence and the writer should not explain it twice."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-drying-yard",
      "kind": "location",
      "name": "The Drying Yard",
      "aliases": [
        "the yard"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Four storeys of hanging cloth and no roof. On a still night you can walk between the sheets like corridors."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-canteen",
      "kind": "location",
      "name": "The Canteen",
      "aliases": [
        "canteen"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Nine tables, pushed into three tonight. One urn, on since four."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "The table arrangement is the vote count. Nobody decided it."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-gate-house",
      "kind": "location",
      "name": "The Gate House",
      "aliases": [
        "the gate",
        "gate house"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Booth, barrier, kettle, stairway up to the foreman's office. A clock stopped at four o'clock since the nineties."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "e-note-voices",
      "kind": "note",
      "name": "On the three voices",
      "aliases": [
        "voices",
        "inner voices"
      ],
      "content": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "Writer-only note — this page cannot be mentioned in the story, which is the point of Notes."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "ARITHMETIC is right and useless. THE HANDS is true and irrelevant. APPETITE is honest and corrosive. If two of them agree in a scene, the third should be the one the player is choosing against."
              }
            ]
          },
          {
            "type": "paragraph",
            "attrs": {
              "speaker": null
            },
            "content": [
              {
                "type": "text",
                "text": "None of them should ever tell the player what to do. They describe; the player decides. The moment a voice says \"you should\", it stops being a faculty and becomes a hint system."
              }
            ]
          }
        ]
      }
    }
  ],
  "stylesheet": "asdfsdf",
  "language": "en"
}