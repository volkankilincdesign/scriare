{
  "name": "scriare",
  "version": "0.86.0",
  "description": "A writing-first workspace for branching narratives.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Volkan Kılınç"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "test": "electron-vite build --mode test && node tests/run.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tiptap/core": "^2.9.1",
    "@tiptap/extension-color": "^2.9.1",
    "@tiptap/extension-font-family": "^2.9.1",
    "@tiptap/extension-highlight": "^2.9.1",
    "@tiptap/extension-placeholder": "^2.9.1",
    "@tiptap/extension-text-align": "^2.9.1",
    "@tiptap/extension-text-style": "^2.9.1",
    "@tiptap/extension-underline": "^2.9.1",
    "@tiptap/pm": "^2.9.1",
    "@tiptap/react": "^2.9.1",
    "@tiptap/starter-kit": "^2.9.1",
    "@tiptap/suggestion": "^2.27.3",
    "@xyflow/react": "^12.3.5",
    "docx": "^9.7.2",
    "jszip": "^3.10.2",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/typography": "^0.5.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright-core": "^1.49.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "productName": "Scriare",
  "license": "UNLICENSED",
  "build": {
    "appId": "com.volkankilinc.scriare",
    "productName": "Scriare",
    "copyright": "© Volkan Kılınç",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scriare-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Scriare",
      "uninstallDisplayName": "Scriare ${version}",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Scriare-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Scriare-${version}-portable.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "scriare",
        "name": "Scriare Story",
        "description": "A Scriare branching story",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ]
  }
}
